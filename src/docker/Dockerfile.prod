# Production Dockerfile for Frostfire Forge Game Server
FROM oven/bun:canary-slim AS base
WORKDIR /app
# Python runs the chat translator (the language service submodule starts it as a child process)
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*

# Install dependencies
FROM base AS deps
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts

# The translator's Python environment, at the path the language service starts it from
FROM base AS translator
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv && rm -rf /var/lib/apt/lists/*
COPY src/language-service/translator/requirements.txt ./src/language-service/translator/
RUN python3 -m venv src/language-service/.venv \
  && src/language-service/.venv/bin/python -m pip install --no-cache-dir -r src/language-service/translator/requirements.txt

# Production stage
FROM base AS production
COPY --from=deps /app/node_modules ./node_modules
COPY . .
COPY --from=translator /app/src/language-service/.venv ./src/language-service/.venv

ARG VERSION=unknown
ARG REVISION=unknown
ARG BUILD_DATE=unknown

ENV APP_VERSION=${VERSION}

LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="Frostfire Forge (Production)" \
      org.opencontainers.image.description="Frostfire Forge Game Server"

EXPOSE 3000
EXPOSE 3000/udp

# create-config also writes an empty .env.production template. Remove it so the
# image holds no env file: the environment is supplied at runtime.
RUN bun create-config --environment production && rm -f .env.production

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD bun --env-file=.env.production --eval "process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0'; const useSSL = process.env.HTTP_USE_SSL === 'true'; const port = useSSL ? (process.env.WEBSRV_PORTSSL || 3000) : (process.env.WEBSRV_PORT || 3000); const protocol = useSSL ? 'https' : 'http'; const res = await fetch(protocol + '://localhost:' + port + '/status').catch(() => ({ok: false})); process.exit(res.ok ? 0 : 1)"

CMD ["sh", "-c", "bun setup-production && exec bun run production"]
